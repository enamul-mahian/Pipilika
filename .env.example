# ---- Core ----
DATABASE_URL="postgresql://pipilika:pipilika@localhost:5432/pipilika"
# Long random string (openssl rand -hex 32)
AUTH_SECRET="change-me-to-a-long-random-string"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Show OTP code on screen (development only! set false in production)
OTP_DEV_SHOW="true"

# ---- Email OTP (SMTP) — leave empty to log codes to server console ----
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Pipilika <no-reply@thepipilika.com>"

# ---- SMS OTP (generic HTTP gateway, e.g. BulkSMSBD / SSL Wireless) ----
# Use {to} and {message} placeholders. Leave empty to log codes to console.
SMS_API_URL=""

# ---- hCaptcha (optional) ----
NEXT_PUBLIC_HCAPTCHA_SITEKEY=""
HCAPTCHA_SECRET=""

# ---- Background removal (optional, remove.bg). Empty = built-in browser removal ----
REMOVE_BG_API_KEY=""

# ---- File storage: "db" (default, in Postgres), "local" (disk) or "s3" (S3 / Cloudflare R2 / DO Spaces) ----
STORAGE_DRIVER="db"
UPLOAD_DIR="./storage"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---- WhatsApp Cloud API (optional) ----
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
WHATSAPP_VERIFY_TOKEN=""
